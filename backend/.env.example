# Copy to .env and customise for your environment.
# Do NOT commit .env to source control.

# HTTP port the server listens on (default: 5000)
PORT=5000

# Application environment: development | production | test
NODE_ENV=development

# SQLite database filename inside the ./data/ directory (default: taskflow.db)
# Set to taskflow.test.db automatically when NODE_ENV=test
DB_FILE=taskflow.db

# Allowed CORS origin. Use '*' only in development.
# In production set to your frontend URL, e.g. https://app.example.com
CORS_ORIGIN=*

# Maximum JSON request body size accepted by the server (default: 50kb)
JSON_BODY_LIMIT=50kb
